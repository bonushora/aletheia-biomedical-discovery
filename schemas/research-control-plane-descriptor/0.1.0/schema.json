{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aletheia:schema:research-control-plane-descriptor:0.1.0",
  "title": "Aletheia Research Control Plane Descriptor v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "descriptor_contract",
    "control_plane",
    "repository",
    "authority",
    "consumes"
  ],
  "properties": {
    "descriptor_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "schema_version"],
      "properties": {
        "name": {"const": "aletheia.research-control-plane-descriptor"},
        "version": {"const": "0.1.0"},
        "schema_version": {"const": "0.1.0"}
      }
    },
    "control_plane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "research_domain"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{1,62}[a-z0-9])$"
        },
        "display_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "research_domain": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "branch", "commit_sha"],
      "properties": {
        "url": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^https?://[^\\s]+$"},
        "branch": {"type": "string", "minLength": 1, "maxLength": 255},
        "commit_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_only", "clinical_authority", "human_scientific_authority_required"],
      "properties": {
        "research_only": {"const": true},
        "clinical_authority": {"const": false},
        "human_scientific_authority_required": {"const": true}
      }
    },
    "consumes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "compatible_versions"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160,
            "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$"
          },
          "compatible_versions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
            }
          }
        }
      }
    }
  }
}
